# Copy ke scripts/deploy.env (di-gitignore) lalu isi.
VM_NAME=ganti-nama-vm-airflow
VM_ZONE=asia-southeast2-a
VM_PROJECT=ganti-project-vm
DAGS_DIR=/data/airflow/dags   # folder DAG di VM (bind mount docker-compose pb-airflow)
DOCKER="docker"               # DOCKER="sudo docker" kalau user SSH belum masuk grup docker (pakai tanda kutip)
USE_IAP=false                 # true kalau SSH ke VM lewat IAP tunnel
