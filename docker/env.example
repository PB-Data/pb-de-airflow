# Tambahkan baris ini ke file .env yang SUDAH ADA di folder docker-compose Airflow (di VM).
# Biarkan AIRFLOW_UID dll yang sudah ada. JANGAN commit .env ke GitHub.

# Image custom hasil docker/Dockerfile (dipakai semua service lewat x-airflow-common)
AIRFLOW_IMAGE_NAME=smi-airflow:3.1.6-dlt

# Sangat disarankan: supaya password Connection terenkripsi di metadata DB
# (docker-compose resmi default-nya kosong = password tersimpan plaintext). Dipakai docker-compose.override.yaml.
# Generate: docker run --rm smi-airflow:3.1.6-dlt python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Connection yang dibuat SEBELUM key diisi tetap tersimpan plaintext (rotate-fernet-key hanya
# meng-enkripsi ulang yang sudah terenkripsi) -> simpan ulang connection lama (edit + save di UI).
AIRFLOW_FERNET_KEY=<isi_fernet_key>
