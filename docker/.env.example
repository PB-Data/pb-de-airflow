# Salin ke .env lalu isi nilainya. JANGAN commit .env.
#   cp .env.example .env
#
# Cara isi yang butuh generate:
#   AIRFLOW__CORE__FERNET_KEY
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   AIRFLOW__API_AUTH__JWT_SECRET
#     openssl rand -hex 32
#   POSTGRES_PASSWORD / _AIRFLOW_WWW_USER_PASSWORD
#     openssl rand -hex 24
#     Pakai hex, JANGAN base64: karakter / + = merusak connection string
#     Postgres yang dirakit di docker-compose.yml.
#
# ATURAN PENULISAN (penyebab paling sering apiserver gagal start):
#   - tulis nilai polos: KEY=abc123
#   - JANGAN pakai tanda kutip: KEY="abc123"  <- salah
#   - JANGAN beri spasi di sekitar "=": KEY = abc123  <- salah
#   - jangan ada karakter # di dalam nilai (dianggap awal komentar)

# --- Identitas user di dalam container (UID pemilik folder /data/airflow) ---
AIRFLOW_UID=

# --- Metadata database (container Postgres) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Kunci Airflow ---
# FERNET_KEY mengenkripsi semua Connection & Variable di metadata DB.
# Kalau hilang, semua kredensial tersimpan jadi tidak bisa didekripsi.
# Simpan salinannya di luar VM.
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=

# --- Login UI Airflow (dibuat sekali oleh airflow-init) ---
_AIRFLOW_WWW_USER_USERNAME=
_AIRFLOW_WWW_USER_PASSWORD=

# Kredensial GCP & database sumber TIDAK ada di sini:
#   - GCP: service account VM lewat metadata server (ADC), tanpa file key.
#   - SQL Server: Airflow Connection (terenkripsi FERNET_KEY), dibuat
#     mengikuti README repo pb-dwh. Project, bucket, dataset: config pb-dwh.
