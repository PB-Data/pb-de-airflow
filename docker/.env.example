# Salin ke .env lalu isi nilainya. JANGAN commit .env.
#   cp .env.example .env
#
# Cara isi yang butuh generate:
#   AIRFLOW__CORE__FERNET_KEY
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   AIRFLOW__API_AUTH__JWT_SECRET
#     openssl rand -hex 32
#   POSTGRES_PASSWORD / _AIRFLOW_WWW_USER_PASSWORD
#     openssl rand -hex 24
#     Pakai hex, JANGAN base64: karakter / + = merusak connection string
#     Postgres yang dirakit di docker-compose.yml.
#
# ATURAN PENULISAN (penyebab paling sering apiserver gagal start):
#   - tulis nilai polos: KEY=abc123
#   - JANGAN pakai tanda kutip: KEY="abc123"  <- salah
#   - JANGAN beri spasi di sekitar "=": KEY = abc123  <- salah
#   - jangan ada karakter # di dalam nilai (dianggap awal komentar)

# --- Identitas user di dalam container (UID pemilik folder /data/airflow) ---
AIRFLOW_UID=

# --- Metadata database (container Postgres) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Kunci Airflow ---
# FERNET_KEY mengenkripsi semua Connection & Variable di metadata DB.
# Kalau hilang, semua kredensial tersimpan jadi tidak bisa didekripsi.
# Simpan salinannya di luar VM.
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=

# --- Login UI Airflow (dibuat sekali oleh airflow-init) ---
_AIRFLOW_WWW_USER_USERNAME=
_AIRFLOW_WWW_USER_PASSWORD=

# --- Target GCP ---
# Kredensial GCP TIDAK ada di sini. Container memakai service account VM
# lewat metadata server (ADC). Tidak ada file JSON key di mana pun.
GCP_PROJECT_ID=
GCS_STAGING_BUCKET=
BQ_DATASET_BRONZE=
BQ_DATASET_SILVER=

# --- Source: Cloud SQL for SQL Server ---
# Satu instance menampung banyak database (PB_DC_SBY, PB_DC_JKT, ...). Nama
# database ditulis per file di config/sources/*.yml (`source.database`), jadi
# di sini cukup host dan login. MSSQL_DATABASE hanya dipakai config yang
# tidak menulis `database`; boleh dikosongkan.
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=

# --- BigQuery ---
# Lokasi dataset. Harus sama dengan lokasi bucket GCS staging, kalau beda
# BigQuery menolak load job-nya.
BQ_LOCATION=asia-southeast2

# --- Retensi log Airflow (hari) ---
# Dipakai oleh cron pembersih di VM; lihat README bagian Troubleshoot.
AIRFLOW_LOG_RETENTION_DAYS=30

# --- Zona waktu ---
# Jadwal cron di config/sources/*.yml ditulis dalam zona waktu ini, bukan UTC.
PB_DWH_TIMEZONE=Asia/Jakarta
